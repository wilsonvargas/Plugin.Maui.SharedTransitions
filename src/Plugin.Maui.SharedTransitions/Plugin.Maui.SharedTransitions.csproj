<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net9.0;net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0;net9.0-windows10.0.19041.0</TargetFrameworks>

		<!-- .NET 9 targets build against MAUI 9 (its last release), .NET 10 targets against the MAUI of the SDK. -->
		<MauiVersion Condition="$(TargetFramework.StartsWith('net9.0'))">9.0.120</MauiVersion>
		<!-- MAUI 9 is out of support (May 2026) but still targeted on purpose, for apps that haven't moved to .NET 10 yet. -->
		<CheckEolWorkloads Condition="$(TargetFramework.StartsWith('net9.0'))">false</CheckEolWorkloads>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- NuGet -->
		<PackageId>Plugin.Maui.SharedTransitions</PackageId>
		<Version>0.1.0</Version>
		<Authors>Wilson Vargas</Authors>
		<Description>Shared element transitions between pages for .NET MAUI (Shell and NavigationPage).</Description>
		<PackageTags>maui;dotnet-maui;animation;transitions;shared-element;hero</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<Copyright>Copyright (c) 2026 Wilson Vargas</Copyright>
		<PackageProjectUrl>https://github.com/wilsonvargas/Plugin.Maui.SharedTransitions</PackageProjectUrl>
		<RepositoryUrl>https://github.com/wilsonvargas/Plugin.Maui.SharedTransitions</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- SourceLink (built into the SDK) and a symbols package, so apps can step into the plugin while debugging. -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<!-- Platform specific code by file suffix: *.android.cs, *.macios.cs, *.fallback.cs -->
	<ItemGroup Condition="!$(TargetFramework.Contains('-android'))">
		<Compile Remove="**\*.android.cs" />
	</ItemGroup>
	<ItemGroup Condition="!$(TargetFramework.Contains('-ios')) And !$(TargetFramework.Contains('-maccatalyst'))">
		<Compile Remove="**\*.macios.cs" />
	</ItemGroup>
	<ItemGroup Condition="$(TargetFramework.Contains('-android')) Or $(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-maccatalyst'))">
		<Compile Remove="**\*.fallback.cs" />
	</ItemGroup>

</Project>
